{
  "name": "simantap",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "SIMANTAP - Simulator Manajemen Aset Negara untuk pembelajaran MK Manajemen BMN, Prodi Akuntansi Sektor Publik, Politeknik Negeri Sambas",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "test:emulator": "firebase emulators:exec --only firestore,auth --project demo-simantap \"node --test --test-concurrency=1 tests/emulator/*.test.js\"",
    "emulators": "firebase emulators:start --only firestore,auth --project demo-simantap"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "firebase": "^11.0.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "firebase-tools": "^15.37.0",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.0"
  }
}
